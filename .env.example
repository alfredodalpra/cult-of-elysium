# Leave these unset to run the storefront on built-in mock data (demo mode).

# Your store's domain, e.g. my-store.myshopify.com
SHOPIFY_STORE_DOMAIN=
# Storefront API public access token (Shopify admin → Apps → Headless / Storefront API)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Webhook signing secret, used to verify X-Shopify-Hmac-Sha256 on /api/revalidate
SHOPIFY_WEBHOOK_SECRET=
